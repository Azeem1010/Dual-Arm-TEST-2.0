digraph G {
rankdir=LR; ranksep=1.0; nodesep=0.25; newrank=true; compound=true;
fontname="Noto Sans CJK TC"; node [fontname="Noto Sans CJK TC", fontsize=12];
edge [arrowsize=0.7, fontname="Noto Sans CJK TC"];
subgraph cluster_0 { label="HMI"; fontsize=16; style="rounded,filled"; fillcolor="#fff3cd"; color="#888888";
  "n:/dual_arm_hmi_command" [label="/dual_arm_hmi_command", shape=ellipse, style=filled, fillcolor=white, penwidth=1.5, fontsize=13];
  "n:/dual_arm_hmi_monitor" [label="/dual_arm_hmi_monitor", shape=ellipse, style=filled, fillcolor=white, penwidth=1.5, fontsize=13];
}
