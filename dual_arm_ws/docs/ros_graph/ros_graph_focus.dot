  "n:/env_scene_node" [label="/env_scene_node", shape=ellipse, style=filled, fillcolor=white, penwidth=1.5, fontsize=13];
  "n:/env_scene_bridge" [label="/env_scene_bridge", shape=ellipse, style=filled, fillcolor=white, penwidth=1.5, fontsize=13];
  "n:/arm1_cam/usb_cam" [label="/arm1_cam/usb_cam", shape=ellipse, style=filled, fillcolor=white, penwidth=1.5, fontsize=13];
  "n:/arm1_cam/image_rotate" [label="/arm1_cam/image_rotate", shape=ellipse, style=filled, fillcolor=white, penwidth=1.5, fontsize=13];
  "n:/arm_camera_switch" [label="/arm_camera_switch", shape=ellipse, style=filled, fillcolor=white, penwidth=1.5, fontsize=13];
}
subgraph cluster_4 { label="MoveIt 規劃"; fontsize=16; style="rounded,filled"; fillcolor="#e2d9f3"; color="#888888";
